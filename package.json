{
  "name": "react-native-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-restart"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "start": "cross-env EXPO_NO_DOTENV=1 expo start",
    "prebuild": "cross-env EXPO_NO_DOTENV=1 expo prebuild",
    "doctor": "npx expo-doctor",
    "reset-project": "node ./app-example/scripts/reset-project.js",
    "sync:colors": "node scripts/sync-colors.mjs",
    "sync:colors:check": "node scripts/sync-colors.mjs --check",
    "android": "cross-env EXPO_NO_DOTENV=1 expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 expo run:ios",
    "ios:device": "cross-env EXPO_NO_DOTENV=1 expo run:ios --device",
    "web": "cross-env EXPO_NO_DOTENV=1 expo start --web",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "install-maestro": "curl -Ls \"https://get.maestro.mobile.dev\" | bash",
    "test:e2e": "maestro test .maestro/ -e APP_ID=com.development.reactnativestarter",
    "prepare": "husky"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    },
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/dom-webview": "58.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@lodev09/react-native-true-sheet": "^3.11.18",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "axios": "^1.20.0",
    "dotenv": "^18.0.8",
    "expo": "~58.0.14",
    "expo-blur": "^58.0.4",
    "expo-build-properties": "^58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "^58.0.7",
    "expo-dev-client": "^58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-router": "~58.0.23",
    "expo-secure-store": "^58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "^58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "goey-native-toast": "^0.2.9",
    "i18next": "^26.5.2",
    "lodash.memoize": "^4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-avoid-softinput": "^9.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "~4.7.1",
    "react-native-restart": "^0.0.29",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-query-kit": "^3.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "uniwind": "^1.12.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@react-native/jest-preset": "^0.88.0",
    "@tailwindcss/node": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^30.0.0",
    "@types/lodash.memoize": "^4.1.9",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
