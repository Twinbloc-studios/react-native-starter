{
  "name": "react-native-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-restart"
        ]
      }
    }
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "doctor": "npx expo-doctor",
    "reset-project": "node ./app-example/scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "install-maestro": "curl -Ls \"https://get.maestro.mobile.dev\" | bash",
    "test:e2e": "maestro test .maestro/ -e APP_ID=com.development.reactnativestarter",
    "prepare": "husky"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@lodev09/react-native-true-sheet": "^3.10.1",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/elements": "^2.9.15",
    "@react-navigation/native": "^7.2.2",
    "@shopify/flash-list": "2.3.1",
    "@tanstack/query-async-storage-persister": "^5.100.7",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-query-persist-client": "^5.100.7",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "expo": "~55.0.19",
    "expo-blur": "^55.0.14",
    "expo-constants": "~55.0.15",
    "expo-crypto": "^55.0.14",
    "expo-dev-client": "^55.0.30",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-router": "~55.0.13",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-store-review": "^55.0.13",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "i18next": "^26.0.8",
    "lodash.memoize": "^4.1.2",
    "moti": "^0.30.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^17.0.6",
    "react-native": "0.85.2",
    "react-native-avoid-softinput": "^8.0.2",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.1",
    "react-query-kit": "^3.3.3",
    "sonner-native": "^0.25.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.6.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tanstack/eslint-plugin-query": "^5.100.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^30.0.0",
    "@types/lodash.memoize": "^4.1.9",
    "@types/react": "~19.2.14",
    "@typescript-eslint/parser": "^8.59.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.3.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-expo": "~55.0.16",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
