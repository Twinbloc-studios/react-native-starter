{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/assets/*": ["assets/*"],
      "@/*": ["src/*"],
      "@env": ["src/lib/env.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".maestro/**/*.js", ".maestro/**/*.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "app-example"
  ]
}
